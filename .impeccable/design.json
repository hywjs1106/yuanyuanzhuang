  "narrative": {
    "keyCharacteristics": [
      "暖纸背景、碳色通讯和提醒详情、局部信号色。",
      "真实本地时间与日期一起位于标题右侧，圆心只显示原创动态地形，四个功能按钮独立位于外侧四角。",
      "紧凑信息行、细线分区、舒适触控区域和五项底部导航。",
      "浅深主题维持同一信息层级；减少动态时仍更新真实时间。"
    ],
    "donts": [
      "**Don't** 让入口压住中心圆或让图标越出容器。",
      "**Don't** 把装饰地形解释为真实定位、地图或遥测。",
      "**Don't** 用首页重复摘要堆叠遮住联系人与最近安排。",
      "**Don't** 将浏览器预览当作原生安装或通知送达验证。"
    ],
    "rules": [
      {
        "section": "colors",
        "name": "The 信号色 Rule",
        "body": "用信号黄标示操作或选中状态；底部导航的选中背景采用 paper-2，并以短黄色下划线确认当前位置。"
      },
      {
        "section": "typography",
        "name": "The 字重 Rule",
        "body": "正文保留常规字重（400），共享标题使用半粗字重（600）；保留联系人等局部组件已有的中间字重。"
      }
    ],
    "dos": [
      "**Do** 复用现有共享令牌、字体和人物资产，并检查最终样式覆盖。",
      "**Do** 保持圆外四角入口、真实本地时钟、标题栏日期和紧凑最近安排。",
      "**Do** 保留清晰焦点、舒适触控区域，以及减少动态时的真实时间更新。",
      "**Do** 用真实业务数据和实际权限状态呈现信息。"
    ],
    "overview": "中文安卓生活工具沿用《终末地》游戏内主菜单、BAKER通讯和任务页面的界面语法：暖纸工作面、碳色阅读面、克制的信号黄，以及清晰的细线和几何图标。参考的产品事实与来源见 [PRODUCT.md](PRODUCT.md) 和 [游戏内界面来源](docs/endfield-ingame-ui-sources.md)。图形为原创抽象地形，不表示真实定位或遥测。\n\n本文记录已经实现的界面。色值与共享字体来自 terminal-tokens.css；尺寸、字重和最终外观同时以最后导入的 terminal-polish.css 为准。保持已有字体、人物与表情资产，以及原有本地业务和原生通知语义。",
    "northStar": "游戏内日常终端"
  }
